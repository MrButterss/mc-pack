{
	chapter.CB36476307F24238.title: "Create: First Spin"
	chapter.CB36476307F24238.chapter_subtitle: [
		"From andesite to steam power"
	]
	quest.92B60F57049E507A.title: "Andesite Alloy"
	quest.92B60F57049E507A.quest_subtitle: "The start of everything"
	quest.92B60F57049E507A.quest_desc: [
		"Craft andesite with iron or zinc nuggets."
		"Almost every early Create part needs it."
	]
	quest.A9B55688999C1409.title: "Free Power"
	quest.A9B55688999C1409.quest_subtitle: "Rotation is your energy"
	quest.A9B55688999C1409.quest_desc: [
		"Put a water wheel in flowing water and run shafts out of it."
		"Cogwheels change direction and speed."
	]
	quest.EDD009689B6F9DCA.title: "Tools of the Trade"
	quest.EDD009689B6F9DCA.quest_subtitle: "See stress, turn blocks"
	quest.EDD009689B6F9DCA.quest_desc: [
		"Goggles show stress and speed when you look at a machine."
		"A wrench rotates blocks. Shift-click picks them up."
	]
	quest.2C9DE266337A38DB.title: "Grinding"
	quest.2C9DE266337A38DB.quest_subtitle: "Ore doubling begins"
	quest.2C9DE266337A38DB.quest_desc: [
		"A millstone grinds ores, gravel and flowers."
		"Later, crushing wheels do it faster."
	]
	quest.32E3EE004F2A3DEE.title: "Pressing Plates"
	quest.32E3EE004F2A3DEE.quest_subtitle: "Sheets for every machine"
	quest.32E3EE004F2A3DEE.quest_desc: [
		"A press flattens ingots into sheets."
		"Put it over a depot or a belt."
	]
	quest.2558DCB6CFAE3749.title: "Belts"
	quest.2558DCB6CFAE3749.quest_subtitle: "Move things around"
	quest.2558DCB6CFAE3749.quest_desc: [
		"Use belts between two shafts to move items."
		"Funnels and chutes take items on and off."
	]
	quest.F06973FA09363450.title: "Mixing"
	quest.F06973FA09363450.quest_subtitle: "Recipes in a basin"
	quest.F06973FA09363450.quest_desc: [
		"Put a mixer over a basin to combine ingredients."
		"JEI shows every mixing recipe."
		"A heated mixer also boils purified water. See Create Homestead."
	]
	quest.8763169A570B1FA1.title: "Brass"
	quest.8763169A570B1FA1.quest_subtitle: "Heat makes alloys"
	quest.8763169A570B1FA1.quest_desc: [
		"Mix copper and zinc in a heated basin."
		"Feed a blaze burner under the basin to heat it."
		"Catch a blaze in an empty blaze burner in the Nether."
	]
	quest.7B889BB783A8AA55.title: "Precision Mechanism"
	quest.7B889BB783A8AA55.quest_subtitle: "Sequenced assembly"
	quest.7B889BB783A8AA55.quest_desc: [
		"Built step by step on a belt with deployers and a press."
		"Check the order in JEI."
	]
	quest.11C2D6CEA05396F1.title: "Steam Power"
	quest.11C2D6CEA05396F1.quest_subtitle: "Big power for a big colony"
	quest.11C2D6CEA05396F1.quest_desc: [
		"Put a fluid tank on a heated blaze burner and attach steam engines."
		"Larger boilers run more engines."
	]
	chapter.F2D05415F0CB11E1.title: "Food Chain"
	chapter.F2D05415F0CB11E1.chapter_subtitle: [
		"Feed yourself, then your colony"
	]
	quest.300AC929A2F58D15.title: "Cutting Board"
	quest.300AC929A2F58D15.quest_subtitle: "Prep station"
	quest.300AC929A2F58D15.quest_desc: [
		"Put food on the board and use a knife on it."
		"Good for slicing, salvaging and stripping logs."
	]
	quest.1760839D7B575742.title: "Cooking Pot"
	quest.1760839D7B575742.quest_subtitle: "Real meals"
	quest.1760839D7B575742.quest_desc: [
		"The pot needs heat under it: a stove, campfire or fire."
		"Meals give longer and better buffs than raw food."
	]
	quest.C32362F7B829EAB1.title: "Rich Soil"
	quest.C32362F7B829EAB1.quest_subtitle: "Better ground"
	quest.C32362F7B829EAB1.quest_desc: [
		"Leave organic compost to turn into rich soil."
		"Crops on it grow faster."
	]
	quest.3FB761741880D0CD.title: "Know the Season"
	quest.3FB761741880D0CD.quest_subtitle: "Crops care about the calendar"
	quest.3FB761741880D0CD.quest_desc: [
		"Most crops only grow in some seasons. Their tooltip shows which."
		"Store food before winter, or build a greenhouse."
		"A deployer with quartz turns a calendar into a season sensor."
	]
	quest.55B85BCE3F1DF0C3.title: "Colony Farmer"
	quest.55B85BCE3F1DF0C3.quest_subtitle: "Let citizens farm"
	quest.55B85BCE3F1DF0C3.quest_desc: [
		"A farmer works fields you mark with a field block."
		"Give them seeds that suit the season."
	]
	quest.5D16047A92E983E1.title: "Feed the Colony"
	quest.5D16047A92E983E1.quest_subtitle: "Hungry citizens are slow citizens"
	quest.5D16047A92E983E1.quest_desc: [
		"The cook hands out food from the restaurant."
		"A varied diet keeps citizens happy."
	]
	quest.E0965F43CF1EFFE5.title: "Automated Kitchen"
	quest.E0965F43CF1EFFE5.quest_subtitle: "Create meets Farmer's Delight"
	quest.E0965F43CF1EFFE5.quest_desc: [
		"Central Kitchen lets deployers and mechanical arms use cooking pots and cutting boards."
		"Tick this once a meal comes out of a machine."
	]
	chapter.20B805B4C2935D77.title: "Aeronautics"
	chapter.20B805B4C2935D77.chapter_subtitle: [
		"Get off the ground"
	]
	quest.1AFB9F91F3182447.title: "Physics Assembler"
	quest.1AFB9F91F3182447.quest_subtitle: "Blocks become a vehicle"
	quest.1AFB9F91F3182447.quest_desc: [
		"Turns a structure you build into a moving physics object."
		"Glue the parts together first."
	]
	quest.1ACEB6527AFF72B8.title: "Propellers"
	quest.1ACEB6527AFF72B8.quest_subtitle: "Thrust"
	quest.1ACEB6527AFF72B8.quest_desc: [
		"Put a propeller on a propeller bearing and turn it."
		"Faster rotation gives more thrust."
	]
	quest.76F281CDB407F3C4.title: "Hot Air"
	quest.76F281CDB407F3C4.quest_subtitle: "Lift by heat"
	quest.76F281CDB407F3C4.quest_desc: [
		"Envelopes hold hot air. A burner under them gives lift."
		"More envelope means more lift."
	]
	quest.64F953A0C77139DB.title: "Levitite"
	quest.64F953A0C77139DB.quest_subtitle: "Lift without fire"
	quest.64F953A0C77139DB.quest_desc: [
		"A block that floats by itself."
		"Expensive, but it lifts a lot in a small space."
	]
	quest.8269E868B776366D.title: "Take the Helm"
	quest.8269E868B776366D.quest_subtitle: "Steering and speed"
	quest.8269E868B776366D.quest_desc: [
		"The wheel steers and the throttle controls the propellers."
		"Put them where you stand."
	]
	quest.C2E6579E44CEC5F3.title: "First Flight"
	quest.C2E6579E44CEC5F3.quest_subtitle: "Up, around, down"
	quest.C2E6579E44CEC5F3.quest_desc: [
		"Assemble your airship, fly a lap of the colony and land without breaking it."
		"Tick this when you're back on the ground."
	]
	chapter.2BAF9529782A9039.title: "Defence"
	chapter.2BAF9529782A9039.chapter_subtitle: [
		"Keep raiders out"
	]
	quest.2270AAD1C5A10E6B.title: "Guard Tower"
	quest.2270AAD1C5A10E6B.quest_subtitle: "First line"
	quest.2270AAD1C5A10E6B.quest_desc: [
		"Guards patrol and fight for the colony."
		"Give them armour and weapons."
	]
	quest.6E653130C34CB1CA.title: "Barracks"
	quest.6E653130C34CB1CA.quest_subtitle: "A standing army"
	quest.6E653130C34CB1CA.quest_desc: [
		"Barracks hold many guards in towers around one hut."
		"Good for colonies that get raided."
	]
	quest.4C25D03ECBE93F8E.title: "Gun Smith"
	quest.4C25D03ECBE93F8E.quest_subtitle: "Firearms"
	quest.4C25D03ECBE93F8E.quest_desc: [
		"Craft guns, ammo and attachments here."
		"Ammo is costly, so save it for raids."
	]
	quest.EF1D8158A006AF1B.title: "Build a Cannon"
	quest.EF1D8158A006AF1B.quest_subtitle: "Big guns"
	quest.EF1D8158A006AF1B.quest_desc: [
		"Build breech, chamber and barrel in a row on a cannon mount."
		"Melt cast iron in a basin first. JEI shows how."
	]
	quest.62787D25AAA71CD1.title: "Ammunition"
	quest.62787D25AAA71CD1.quest_subtitle: "Load and fire"
	quest.62787D25AAA71CD1.quest_desc: [
		"Load powder charges, then a shot, from the breech end."
		"More charges shoot farther, but too many burst the barrel."
	]
	chapter.2423BA4DFF1F35C5.title: "Create Homestead"
	chapter.2423BA4DFF1F35C5.chapter_subtitle: [
		"Create machines for water, seasons and the colony"
	]
	quest.4F40A43246E31EA0.title: "Clean Water"
	quest.4F40A43246E31EA0.quest_subtitle: "Boil it in bulk"
	quest.4F40A43246E31EA0.quest_desc: [
		"A heated mixer turns a glass bottle and 250 mB of water into purified water."
		"The water purifier still works if you have no blaze burner yet."
	]
	quest.23ACC8CB18EF82CD.title: "Juice Bar"
	quest.23ACC8CB18EF82CD.quest_subtitle: "Sugar, fruit, purified water"
	quest.23ACC8CB18EF82CD.quest_desc: [
		"An unheated mixer makes any Tough As Nails juice."
		"Put one kind of fruit per basin, or you may get the wrong juice."
	]
	quest.B930AF8C03071C5B.title: "Canteen"
	quest.B930AF8C03071C5B.quest_subtitle: "Carry your water"
	quest.B930AF8C03071C5B.quest_desc: [
		"Fill it at a purifier or with purified water to drink on the road."
	]
	quest.A1914C5AF7A3E695.title: "Weather Station"
	quest.A1914C5AF7A3E695.quest_subtitle: "Deploy quartz onto a calendar"
	quest.A1914C5AF7A3E695.quest_desc: [
		"A deployer holding quartz turns a calendar into a season sensor."
		"It outputs redstone by season: automate your greenhouse."
	]
	quest.CB323B825C65617A.title: "Colony Logistics"
	quest.CB323B825C65617A.quest_subtitle: "Wire the warehouse into Create"
	quest.CB323B825C65617A.quest_desc: [
		"A deployer holding a gold scepter turns a chest into a warehouse hut, or a smoker into a kitchen hut."
		"The warehouse stock link lets Create's logistics read and order from the colony warehouse."
		"The Smart Colony Clipboard turns colony requests into Create orders."
	]
	quest.88B4FD158ACA9768.title: "Schematic Workbench"
	quest.88B4FD158ACA9768.quest_subtitle: "Optional"
	quest.88B4FD158ACA9768.quest_desc: [
		"Build colony schematics with Create parts."
	]
}
