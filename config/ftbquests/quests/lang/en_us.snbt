{
	chapter.CB36476307F24238.title: "Create: First Spin"
	chapter.CB36476307F24238.chapter_subtitle: [
		"From andesite to steam power"
	]
	quest.92B60F57049E507A.title: "Andesite Alloy"
	quest.92B60F57049E507A.quest_subtitle: "The start of everything"
	quest.92B60F57049E507A.quest_desc: [
		"Craft andesite with iron or zinc nuggets."
		"Almost every early Create part needs it."
	]
	quest.A9B55688999C1409.title: "Free Power"
	quest.A9B55688999C1409.quest_subtitle: "Rotation is your energy"
	quest.A9B55688999C1409.quest_desc: [
		"Put a water wheel in flowing water and run shafts out of it."
		"Cogwheels change direction and speed."
	]
	quest.EDD009689B6F9DCA.title: "Tools of the Trade"
	quest.EDD009689B6F9DCA.quest_subtitle: "See stress, turn blocks"
	quest.EDD009689B6F9DCA.quest_desc: [
		"Goggles show stress and speed when you look at a machine."
		"A wrench rotates blocks. Shift-click picks them up."
	]
	quest.2C9DE266337A38DB.title: "Grinding"
	quest.2C9DE266337A38DB.quest_subtitle: "Ore doubling begins"
	quest.2C9DE266337A38DB.quest_desc: [
		"A millstone grinds ores, gravel and flowers."
		"Later, crushing wheels do it faster."
	]
	quest.32E3EE004F2A3DEE.title: "Pressing Plates"
	quest.32E3EE004F2A3DEE.quest_subtitle: "Sheets for every machine"
	quest.32E3EE004F2A3DEE.quest_desc: [
		"A press flattens ingots into sheets."
		"Put it over a depot or a belt."
	]
	quest.2558DCB6CFAE3749.title: "Belts"
	quest.2558DCB6CFAE3749.quest_subtitle: "Move things around"
	quest.2558DCB6CFAE3749.quest_desc: [
		"Use belts between two shafts to move items."
		"Funnels and chutes take items on and off."
	]
	quest.F06973FA09363450.title: "Mixing"
	quest.F06973FA09363450.quest_subtitle: "Recipes in a basin"
	quest.F06973FA09363450.quest_desc: [
		"Put a mixer over a basin to combine ingredients."
		"JEI shows every mixing recipe."
		"A heated mixer also boils purified water. See Create Homestead."
	]
	quest.8763169A570B1FA1.title: "Brass"
	quest.8763169A570B1FA1.quest_subtitle: "Heat makes alloys"
	quest.8763169A570B1FA1.quest_desc: [
		"Mix copper and zinc in a heated basin."
		"Feed a blaze burner under the basin to heat it."
		"Catch a blaze in an empty blaze burner in the Nether."
	]
	quest.7B889BB783A8AA55.title: "Precision Mechanism"
	quest.7B889BB783A8AA55.quest_subtitle: "Sequenced assembly"
	quest.7B889BB783A8AA55.quest_desc: [
		"Built step by step on a belt with deployers and a press."
		"Check the order in JEI."
	]
	quest.11C2D6CEA05396F1.title: "Steam Power"
	quest.11C2D6CEA05396F1.quest_subtitle: "Big power for a big colony"
	quest.11C2D6CEA05396F1.quest_desc: [
		"Put a fluid tank on a heated blaze burner and attach steam engines."
		"Larger boilers run more engines."
	]
	chapter.F2D05415F0CB11E1.title: "Food Chain"
	chapter.F2D05415F0CB11E1.chapter_subtitle: [
		"Feed yourself, then your colony"
	]
	quest.300AC929A2F58D15.title: "Cutting Board"
	quest.300AC929A2F58D15.quest_subtitle: "Prep station"
	quest.300AC929A2F58D15.quest_desc: [
		"Put food on the board and use a knife on it."
		"Good for slicing, salvaging and stripping logs."
	]
	quest.1760839D7B575742.title: "Cooking Pot"
	quest.1760839D7B575742.quest_subtitle: "Real meals"
	quest.1760839D7B575742.quest_desc: [
		"The pot needs heat under it: a stove, campfire or fire."
		"Meals give longer and better buffs than raw food."
	]
	quest.C32362F7B829EAB1.title: "Rich Soil"
	quest.C32362F7B829EAB1.quest_subtitle: "Better ground"
	quest.C32362F7B829EAB1.quest_desc: [
		"Leave organic compost to turn into rich soil."
		"Crops on it grow faster."
	]
	quest.3FB761741880D0CD.title: "Know the Season"
	quest.3FB761741880D0CD.quest_subtitle: "Crops care about the calendar"
	quest.3FB761741880D0CD.quest_desc: [
		"Most crops only grow in some seasons. Their tooltip shows which."
		"Store food before winter, or build a greenhouse."
		"A deployer with quartz turns a calendar into a season sensor."
	]
	quest.55B85BCE3F1DF0C3.title: "Colony Farmer"
	quest.55B85BCE3F1DF0C3.quest_subtitle: "Let citizens farm"
	quest.55B85BCE3F1DF0C3.quest_desc: [
		"A farmer works fields you mark with a field block."
		"Give them seeds that suit the season."
	]
	quest.5D16047A92E983E1.title: "Feed the Colony"
	quest.5D16047A92E983E1.quest_subtitle: "Hungry citizens are slow citizens"
	quest.5D16047A92E983E1.quest_desc: [
		"The cook hands out food from the restaurant."
		"A varied diet keeps citizens happy."
	]
	quest.E0965F43CF1EFFE5.title: "Automated Kitchen"
	quest.E0965F43CF1EFFE5.quest_subtitle: "Create meets Farmer's Delight"
	quest.E0965F43CF1EFFE5.quest_desc: [
		"Central Kitchen lets deployers and mechanical arms use cooking pots and cutting boards."
		"Tick this once a meal comes out of a machine."
	]
	chapter.20B805B4C2935D77.title: "Aeronautics"
	chapter.20B805B4C2935D77.chapter_subtitle: [
		"Get off the ground"
	]
	quest.1AFB9F91F3182447.title: "Physics Assembler"
	quest.1AFB9F91F3182447.quest_subtitle: "Blocks become a vehicle"
	quest.1AFB9F91F3182447.quest_desc: [
		"Turns a structure you build into a moving physics object."
		"Glue the parts together first."
	]
	quest.1ACEB6527AFF72B8.title: "Propellers"
	quest.1ACEB6527AFF72B8.quest_subtitle: "Thrust"
	quest.1ACEB6527AFF72B8.quest_desc: [
		"Put a propeller on a propeller bearing and turn it."
		"Faster rotation gives more thrust."
	]
	quest.76F281CDB407F3C4.title: "Hot Air"
	quest.76F281CDB407F3C4.quest_subtitle: "Lift by heat"
	quest.76F281CDB407F3C4.quest_desc: [
		"Envelopes hold hot air. A burner under them gives lift."
		"More envelope means more lift."
	]
	quest.64F953A0C77139DB.title: "Levitite"
	quest.64F953A0C77139DB.quest_subtitle: "Lift without fire"
	quest.64F953A0C77139DB.quest_desc: [
		"A block that floats by itself."
		"Expensive, but it lifts a lot in a small space."
	]
	quest.8269E868B776366D.title: "Take the Helm"
	quest.8269E868B776366D.quest_subtitle: "Steering and speed"
	quest.8269E868B776366D.quest_desc: [
		"The wheel steers and the throttle controls the propellers."
		"Put them where you stand."
	]
	quest.C2E6579E44CEC5F3.title: "First Flight"
	quest.C2E6579E44CEC5F3.quest_subtitle: "Up, around, down"
	quest.C2E6579E44CEC5F3.quest_desc: [
		"Assemble your airship, fly a lap of the colony and land without breaking it."
		"Tick this when you're back on the ground."
	]
	chapter.2BAF9529782A9039.title: "Defence"
	chapter.2BAF9529782A9039.chapter_subtitle: [
		"Keep raiders out"
	]
	quest.2270AAD1C5A10E6B.title: "Guard Tower"
	quest.2270AAD1C5A10E6B.quest_subtitle: "First line"
	quest.2270AAD1C5A10E6B.quest_desc: [
		"Guards patrol and fight for the colony."
		"Give them armour and weapons."
	]
	quest.6E653130C34CB1CA.title: "Barracks"
	quest.6E653130C34CB1CA.quest_subtitle: "A standing army"
	quest.6E653130C34CB1CA.quest_desc: [
		"Barracks hold many guards in towers around one hut."
		"Good for colonies that get raided."
	]
	quest.4C25D03ECBE93F8E.title: "Gun Smith"
	quest.4C25D03ECBE93F8E.quest_subtitle: "Firearms"
	quest.4C25D03ECBE93F8E.quest_desc: [
		"Craft guns, ammo and attachments here."
		"Ammo is costly, so save it for raids."
	]
	quest.EF1D8158A006AF1B.title: "Build a Cannon"
	quest.EF1D8158A006AF1B.quest_subtitle: "Big guns"
	quest.EF1D8158A006AF1B.quest_desc: [
		"Build breech, chamber and barrel in a row on a cannon mount."
		"Melt cast iron in a basin first. JEI shows how."
	]
	quest.62787D25AAA71CD1.title: "Ammunition"
	quest.62787D25AAA71CD1.quest_subtitle: "Load and fire"
	quest.62787D25AAA71CD1.quest_desc: [
		"Load powder charges, then a shot, from the breech end."
		"More charges shoot farther, but too many burst the barrel."
	]
	chapter.3D815497E86DDD98.title: "Arsenal"
	chapter.3D815497E86DDD98.chapter_subtitle: [
		"Gear up"
	]
	chapter.96E3E651849E4E6D.title: "Exploration"
	chapter.96E3E651849E4E6D.chapter_subtitle: [
		"See what's out there"
	]
	chapter.B49587F0DF23C57A.title: "Storage & Building"
	chapter.B49587F0DF23C57A.chapter_subtitle: [
		"Sort it, then build it"
	]
	chapter.E4D562D3A234579E.title: "Seasons & Survival"
	chapter.E4D562D3A234579E.chapter_subtitle: [
		"Weather the world"
	]
	chapter.F87C397FDD8203B6.title: "Delights & Drinks"
	chapter.F87C397FDD8203B6.chapter_subtitle: [
		"Beyond the cooking pot"
	]
	chapter.BE1DEB3E14E92128.title: "Create Addons"
	chapter.BE1DEB3E14E92128.chapter_subtitle: [
		"Power, steel and style"
	]
	chapter.CBAB7D25AFF681F2.title: "Create: Logistics & Trains"
	chapter.CBAB7D25AFF681F2.chapter_subtitle: [
		"Move items and people"
	]
	chapter.4293304A7ED33867.title: "Welcome"
	chapter.4293304A7ED33867.chapter_subtitle: [
		"Settle in before the colony"
	]
	quest.0AFFB9CE7BEB0188.title: "Pack Up"
	quest.0AFFB9CE7BEB0188.quest_subtitle: "More pockets"
	quest.0AFFB9CE7BEB0188.quest_desc: [
		"A backpack holds a chest's worth of items and takes upgrades."
		"Carry On lets you pick up chests and animals with empty hands and shift-right-click."
	]
	quest.DCBA76223408E216.title: "Sleep Anywhere"
	quest.DCBA76223408E216.quest_subtitle: "Skip the night, keep your spawn"
	quest.DCBA76223408E216.quest_desc: [
		"A sleeping bag skips the night without moving your spawn point. Any colour works; the red one counts here."
	]
	quest.8A3CB1D6E9F176B3.title: "Find Your Way"
	quest.8A3CB1D6E9F176B3.quest_subtitle: "Point to any biome"
	quest.8A3CB1D6E9F176B3.quest_desc: [
		"Nature's Compass searches for the biome you pick."
	]
	quest.1FFCFFAF8009D06E.title: "Home Stone"
	quest.1FFCFFAF8009D06E.quest_subtitle: "Fast travel"
	quest.1FFCFFAF8009D06E.quest_desc: [
		"Place a waystone at home, then teleport back from any other waystone."
	]
	quest.081014282EB990D3.title: "Into the Colony"
	quest.081014282EB990D3.quest_subtitle: "Start the MineColonies Questline"
	quest.081014282EB990D3.quest_desc: [
		"The MineColonies Questline chapter walks you through your first colony."
		"Stylecolonies and SmallColonies add more building styles to pick from."
	]
	quest.DE72077A69394D5C.title: "Funnels"
	quest.DE72077A69394D5C.quest_subtitle: "Belts in, belts out"
	quest.DE72077A69394D5C.quest_desc: [
		"Funnels pull items off belts and push them into containers."
	]
	quest.A881CADD9E3F7F87.title: "Deployer"
	quest.A881CADD9E3F7F87.quest_subtitle: "A mechanical hand"
	quest.A881CADD9E3F7F87.quest_desc: [
		"A deployer uses whatever it holds: places blocks, applies items, even fights."
	]
	quest.630ABB7BAC8502FE.title: "Rails"
	quest.630ABB7BAC8502FE.quest_subtitle: "Lay the line"
	quest.630ABB7BAC8502FE.quest_desc: [
		"Create track bends smoothly. Hold track and right-click two points to connect them."
	]
	quest.847E80170D54447F.title: "Station"
	quest.847E80170D54447F.quest_subtitle: "Every train needs a home"
	quest.847E80170D54447F.quest_desc: [
		"Stations assemble trains and hold their schedules."
	]
	quest.0732465779D6DE2F.title: "Choo Choo"
	quest.0732465779D6DE2F.quest_subtitle: "Assemble a train"
	quest.0732465779D6DE2F.quest_desc: [
		"Build a train on a station and drive it. Create Blocks Bogies and Movable Tracks add more bogie and track options."
	]
	quest.85431081E8F0F620.title: "Steam 'n' Rails"
	quest.85431081E8F0F620.quest_subtitle: "More track styles"
	quest.85431081E8F0F620.quest_desc: [
		"Steam 'n' Rails adds track for every wood type, plus narrow and wide gauges."
	]
	quest.1290E90FCDE3BD12.title: "Extra Tracks"
	quest.1290E90FCDE3BD12.quest_subtitle: "Optional"
	quest.1290E90FCDE3BD12.quest_desc: [
		"Create: Tracks adds tank-style track drives for contraptions."
	]
	quest.22A03F0D3C5B985E.title: "Electric Motor"
	quest.22A03F0D3C5B985E.quest_subtitle: "Rotation from power"
	quest.22A03F0D3C5B985E.quest_desc: [
		"Create Crafts & Additions turns rotation into electricity and back."
	]
	quest.29707F91B5FF2B56.title: "Liquid XP"
	quest.29707F91B5FF2B56.quest_subtitle: "Enchant by machine"
	quest.29707F91B5FF2B56.quest_desc: [
		"Create: Enchantment Industry stores experience as a fluid and enchants items with it."
	]
	quest.4CECF77DE8F8C4C9.title: "Copycat"
	quest.4CECF77DE8F8C4C9.quest_subtitle: "Any block, any shape"
	quest.4CECF77DE8F8C4C9.quest_desc: [
		"Copycats take the look of any block you put in them."
	]
	quest.799856F6F2B7A670.title: "Steel Works"
	quest.799856F6F2B7A670.quest_subtitle: "Heavy industry"
	quest.799856F6F2B7A670.quest_desc: [
		"Create: The Factory Must Grow makes steel in a blast furnace."
		"Steel Armor Blocks turns steel into decorative armour plating."
	]
	quest.C3287DB7DE86F8FB.title: "Tinkerer"
	quest.C3287DB7DE86F8FB.quest_subtitle: "Optional"
	quest.C3287DB7DE86F8FB.quest_desc: [
		"Create Deco adds catwalks, bars and lamps."
		"Also in the pack: Create Connected, Stuff Additions, Linear Bearing, Ender Transmission, Dragons Plus, Molten Vents, Cobblestone, Central Kitchen, Blazing Hot and Multi-Piston."
	]
	quest.DBC0D63522B7B548.title: "Moving Stairs"
	quest.DBC0D63522B7B548.quest_subtitle: "Optional"
	quest.DBC0D63522B7B548.quest_desc: [
		"Create Escalated adds escalators and moving walkways."
	]
	quest.E75AAE2F6AC374E4.title: "Keg"
	quest.E75AAE2F6AC374E4.quest_subtitle: "Brew it slowly"
	quest.E75AAE2F6AC374E4.quest_desc: [
		"A keg ferments drinks over time. Keep it at the right temperature."
	]
	quest.BC849BA5FA65C37C.title: "First Brew"
	quest.BC849BA5FA65C37C.quest_subtitle: "Cheers"
	quest.BC849BA5FA65C37C.quest_desc: [
		"Beer is the first brew. Drinks give long buffs, but too many make you tipsy."
	]
	quest.A55B87582CCA4411.title: "Gone Fishing"
	quest.A55B87582CCA4411.quest_subtitle: "Better rods, more fish"
	quest.A55B87582CCA4411.quest_desc: [
		"Aquaculture adds fish for every biome. Many become Farmer's Delight dishes."
	]
	quest.D26D904D052CEFB5.title: "Feast"
	quest.D26D904D052CEFB5.quest_subtitle: "Cook six different dishes"
	quest.D26D904D052CEFB5.quest_desc: [
		"Cultural Delights, Fruits Delight and Cook's Collection add more recipes. Mark this done after six different dishes."
	]
	quest.9EA620CD47A273FE.title: "Blood Moon"
	quest.9EA620CD47A273FE.quest_subtitle: "Survive the night"
	quest.9EA620CD47A273FE.quest_desc: [
		"Enhanced Celestials brings blood moons with more mobs. Mark this done after surviving one."
	]
	quest.837853F77EBE73C8.title: "Wildlife"
	quest.837853F77EBE73C8.quest_subtitle: "Deer drop antlers"
	quest.837853F77EBE73C8.quest_desc: [
		"Naturalist adds animals to most biomes. Deer drop antlers."
	]
	quest.FA03A1FC9FBACE9A.title: "Drawers"
	quest.FA03A1FC9FBACE9A.quest_subtitle: "One item, many stacks"
	quest.FA03A1FC9FBACE9A.quest_desc: [
		"A drawer holds lots of one item and shows it on the front."
	]
	quest.DE6A1BA92FF5B365.title: "Controller"
	quest.DE6A1BA92FF5B365.quest_subtitle: "One face for all drawers"
	quest.DE6A1BA92FF5B365.quest_desc: [
		"A controller links touching drawers so you can insert into all of them at once."
	]
	quest.25EDBFFA2608B3B5.title: "Terminal"
	quest.25EDBFFA2608B3B5.quest_subtitle: "Search every chest"
	quest.25EDBFFA2608B3B5.quest_desc: [
		"Tom's Simple Storage links chests to one searchable terminal."
	]
	quest.C94286A5EE46559D.title: "Architect"
	quest.C94286A5EE46559D.quest_subtitle: "Mix any two blocks"
	quest.C94286A5EE46559D.quest_desc: [
		"The architect's cutter combines blocks into new building pieces."
	]
	quest.92D181726CAD0478.title: "Chisel"
	quest.92D181726CAD0478.quest_subtitle: "Hundreds of variants"
	quest.92D181726CAD0478.quest_desc: [
		"Chipped workbenches turn blocks into variants. Chisel Reborn and Rechiseled add more, and Rechiseled: Create connects them to Create."
	]
	quest.BFF6FFC023216722.title: "Wand"
	quest.BFF6FFC023216722.quest_subtitle: "Build faster"
	quest.BFF6FFC023216722.quest_desc: [
		"A construction wand extends the face you click."
	]
	quest.28DB2C85414DE003.title: "Magnet"
	quest.28DB2C85414DE003.quest_subtitle: "Pull drops to you"
	quest.28DB2C85414DE003.quest_desc: [
		"Right-click to toggle it."
	]
	quest.DB442CE9A4731D31.title: "Odds and Ends"
	quest.DB442CE9A4731D31.quest_subtitle: "Optional"
	quest.DB442CE9A4731D31.quest_desc: [
		"Supplementaries and Amendments add jars, signs, ropes and many small blocks."
	]
	quest.B9D27ED0D49431C8.title: "Framed"
	quest.B9D27ED0D49431C8.quest_subtitle: "Optional"
	quest.B9D27ED0D49431C8.quest_desc: [
		"Framed blocks copy any texture. Factory Blocks adds industrial decor."
	]
	quest.C8620B5452626560.title: "Big Chest"
	quest.C8620B5452626560.quest_subtitle: "Optional"
	quest.C8620B5452626560.quest_desc: [
		"Sophisticated Storage chests take tier and feature upgrades."
	]
	quest.273D4F5027255380.title: "A Proper House"
	quest.273D4F5027255380.quest_subtitle: "Build a home you like"
	quest.273D4F5027255380.quest_desc: [
		"Twigs adds small decor like pebbles and tables. Mark this done when the house feels like home."
	]
	quest.F380BFCC1D8C6FCD.title: "Explorer's Log"
	quest.F380BFCC1D8C6FCD.quest_subtitle: "Optional"
	quest.F380BFCC1D8C6FCD.quest_desc: [
		"Visit a YUNG's, Dungeons and Taverns, Moog's Voyager, Explorify or Structory structure. Structures are spread out, so this can take a while."
	]
	quest.352B7F34D01E3A6B.title: "Loot Run"
	quest.352B7F34D01E3A6B.quest_subtitle: "Your own loot"
	quest.352B7F34D01E3A6B.quest_desc: [
		"Lootr chests give every player their own loot. Mark this done after opening one."
	]
	quest.A46FC070D2968DE2.title: "Spelunker"
	quest.A46FC070D2968DE2.quest_subtitle: "Mine smarter"
	quest.A46FC070D2968DE2.quest_desc: [
		"Spelunkery adds a hammer and chisel to split stone and mine ore more cleanly."
	]
	quest.A94025531BA28129.title: "Into the Nether"
	quest.A94025531BA28129.quest_subtitle: "Mark when you arrive"
	quest.A94025531BA28129.quest_desc: [
		"Build a portal and step through."
	]
	quest.7434A9E30D4E9BB7.title: "Trading Post"
	quest.7434A9E30D4E9BB7.quest_subtitle: "All villagers in one place"
	quest.7434A9E30D4E9BB7.quest_desc: [
		"The trading post shows every nearby villager's trades in one screen."
	]
	quest.0D7A1EAFBBB0C184.title: "First Gun"
	quest.0D7A1EAFBBB0C184.quest_subtitle: "Craft any gun"
	quest.0D7A1EAFBBB0C184.quest_desc: [
		"Make a gun at the gun smith table. Mark this done once you have one."
	]
	quest.484BD840F5BA2760.title: "Shield Up"
	quest.484BD840F5BA2760.quest_subtitle: "Block better"
	quest.484BD840F5BA2760.quest_desc: [
		"Shield Expansion adds shields that parry and block different amounts."
	]
	quest.C8491AE9F8EC71B0.title: "Armoured"
	quest.C8491AE9F8EC71B0.quest_subtitle: "Full iron set"
	quest.C8491AE9F8EC71B0.quest_desc: [
		"Overloaded Armor Bar shows armour points past 20 as coloured rows."
	]
	quest.FD62DA978C6E914E.title: "Floaters"
	quest.FD62DA978C6E914E.quest_subtitle: "Keep it on the water"
	quest.FD62DA978C6E914E.quest_desc: [
		"Sable Floaters keep ships and contraptions afloat."
	]
	quest.3ED4CB97B0E82DE7.title: "Long Haul"
	quest.3ED4CB97B0E82DE7.quest_subtitle: "Fly 1000 blocks"
	quest.3ED4CB97B0E82DE7.quest_desc: [
		"Fly to a waystone at least 1000 blocks from home. Mark this done when you land."
	]
	quest.1A93F565CA4E53D4.title: "Radar Room"
	quest.1A93F565CA4E53D4.quest_subtitle: "See what's coming"
	quest.1A93F565CA4E53D4.quest_desc: [
		"Create Radars tracks ships and mobs on a monitor."
	]
	quest.DBBD43FBAA8DD937.title: "Thrust"
	quest.DBBD43FBAA8DD937.quest_subtitle: "Optional"
	quest.DBBD43FBAA8DD937.quest_desc: [
		"Create Propulsion adds thrusters that push contraptions."
	]
	chapter.2423BA4DFF1F35C5.title: "Create Homestead"
	chapter.2423BA4DFF1F35C5.chapter_subtitle: [
		"Create machines for water, seasons and the colony"
	]
	quest.4F40A43246E31EA0.title: "Clean Water"
	quest.4F40A43246E31EA0.quest_subtitle: "Boil it in bulk"
	quest.4F40A43246E31EA0.quest_desc: [
		"A heated mixer turns a glass bottle and 250 mB of water into purified water."
		"The water purifier still works if you have no blaze burner yet."
	]
	quest.23ACC8CB18EF82CD.title: "Juice Bar"
	quest.23ACC8CB18EF82CD.quest_subtitle: "Sugar, fruit, purified water"
	quest.23ACC8CB18EF82CD.quest_desc: [
		"An unheated mixer makes any Tough As Nails juice."
		"Put one kind of fruit per basin, or you may get the wrong juice."
	]
	quest.B930AF8C03071C5B.title: "Canteen"
	quest.B930AF8C03071C5B.quest_subtitle: "Carry your water"
	quest.B930AF8C03071C5B.quest_desc: [
		"Fill it at a purifier or with purified water to drink on the road."
	]
	quest.A1914C5AF7A3E695.title: "Weather Station"
	quest.A1914C5AF7A3E695.quest_subtitle: "Deploy quartz onto a calendar"
	quest.A1914C5AF7A3E695.quest_desc: [
		"A deployer holding quartz turns a calendar into a season sensor."
		"It outputs redstone by season: automate your greenhouse."
	]
	quest.CB323B825C65617A.title: "Colony Logistics"
	quest.CB323B825C65617A.quest_subtitle: "Wire the warehouse into Create"
	quest.CB323B825C65617A.quest_desc: [
		"A deployer holding a gold scepter turns a chest into a warehouse hut, or a smoker into a kitchen hut."
		"The warehouse stock link lets Create's logistics read and order from the colony warehouse."
		"The Smart Colony Clipboard turns colony requests into Create orders."
	]
