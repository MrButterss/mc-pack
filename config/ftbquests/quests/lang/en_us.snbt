	quest.DE6A1BA92FF5B365.quest_subtitle: "One face for all drawers"
	quest.25EDBFFA2608B3B5.quest_subtitle: "Search every chest"
	quest.C94286A5EE46559D.quest_subtitle: "Mix any two blocks"
	quest.92D181726CAD0478.quest_subtitle: "Hundreds of variants"
	quest.BFF6FFC023216722.quest_subtitle: "Build faster"
